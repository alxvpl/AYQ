<!--
  The other half of the invented pair. A savings account of the same person,
  receiving the 500.00 that ayq-own-current.xml sent, and earning some interest
  the bank paid.

  The money arriving here is not income: it is money that was already the
  person's, in another account. 03 §7.6. The interest is income and stays so.

  The IBANs, names and amounts belong to no one.
-->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.053.001.02">
  <BkToCstmrStmt>
    <GrpHdr>
      <MsgId>camt053-202608-own-savings</MsgId>
      <CreDtTm>2026-09-01T03:04:05</CreDtTm>
    </GrpHdr>
    <Stmt>
      <Id>NL00TEST0033334444.2026-08</Id>
      <LglSeqNb>171</LglSeqNb>
      <CreDtTm>2026-09-01T03:04:05</CreDtTm>
      <FrToDt>
        <FrDtTm>2026-08-01T00:00:00</FrDtTm>
        <ToDtTm>2026-08-31T23:59:59</ToDtTm>
      </FrToDt>
      <Acct>
        <Id><IBAN>NL00TEST0033334444</IBAN></Id>
        <Ccy>EUR</Ccy>
        <Ownr><Nm>J. TESTPERSOON</Nm></Ownr>
        <Svcr><FinInstnId><BIC>ABNANL2A</BIC></FinInstnId></Svcr>
      </Acct>

      <Bal>
