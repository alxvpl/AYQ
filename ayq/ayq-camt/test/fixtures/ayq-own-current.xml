<?xml version="1.0" encoding="UTF-8"?>
<!--
  One half of an invented pair: a current account that moves money to a savings
  account of the same person, and spends some money on something real.

  Its partner is ayq-own-savings.xml, whose account IBAN is this statement's
  counterparty IBAN and the other way round. Together they are what 03 §7.6
  is about: money that leaves one account and arrives in another is a movement,
  never an expense and never income, whichever of the two counts toward
  available funds.

  The IBANs, names and amounts belong to no one.
-->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.053.001.02">
  <BkToCstmrStmt>
    <GrpHdr>
      <MsgId>camt053-202608-own-current</MsgId>
