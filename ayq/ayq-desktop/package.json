{
  "name": "ayq-desktop",
  "version": "0.1.0",
  "description": "The AYQ Electron host: window, typed IPC relay, and the forked Actual engine.",
  "main": "dist/ayq-main.js",
  "scripts": {
    "setup": "node setup.mjs",
    "verify:native": "node verify-native.mjs",
    "build:client": "node ../ayq-client/build.mjs",
    "build": "npm run build:client && node build.mjs",
    "start": "node start.mjs",
    "smoke": "node start.mjs --smoke --require-host \"electron utilityProcess\"",
    "start:debug-node-engine": "node start.mjs --engine node",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.ts"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@actual-app/api": "26.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.3",
    "@types/node": "22.15.3",
    "electron": "43.4.0",
    "esbuild": "0.24.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
