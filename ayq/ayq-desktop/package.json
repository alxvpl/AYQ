{
  "name": "ayq-desktop",
  "version": "0.1.0",
  "description": "AYQ \u2014 a local personal finance desktop application.",
  "main": "dist/ayq-main.js",
  "scripts": {
    "setup": "node setup.mjs",
    "verify:native": "node verify-native.mjs",
    "build:client": "node ../ayq-client/build.mjs",
    "build": "npm run build:client && node build.mjs",
    "start": "node start.mjs",
    "smoke": "node start.mjs --smoke --require-host \"electron utilityProcess\"",
    "start:debug-node-engine": "node start.mjs --engine node",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-reporter=spec --test-concurrency=1 --test-timeout=420000 \"test/*.test.ts\"",
    "icon": "node build-icon.mjs",
    "package": "npm run build && npm run icon && electron-builder --win nsis --x64 --publish=never"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@actual-app/api": "26.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.3",
    "@types/node": "22.15.3",
    "electron": "43.4.0",
    "electron-builder": "26.8.1",
    "esbuild": "0.24.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "node-gyp": "13.0.2"
  },
  "productName": "AYQ",
  "build": {
    "appId": "eu.ayq.desktop",
    "productName": "AYQ",
    "copyright": "AYQ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/better-sqlite3/{benchmark,src,bin,docs,deps,build/Release/obj}"
    ],
    "asarUnpack": [
      "**/node_modules/@actual-app/api/**",
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AYQ"
    },
    "publish": null
  },
  "author": "AYQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxvpl/AYQ.git",
    "directory": "ayq/ayq-desktop"
  }
}
