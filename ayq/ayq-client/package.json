  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.24.2",
    "jsdom": "26.1.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "main": "src/ayq-ipc-contract.ts",
  "dependencies": {
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-icons": "2.0.341",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
